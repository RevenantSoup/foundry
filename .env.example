# Copy to ignored .env for Compose; use unique secrets, not these placeholders.
FOUNDRY_ADMIN_USER=admin
FOUNDRY_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
FOUNDRY_SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_VERSION=0.1.0
FOUNDRY_ROOT=/data
FOUNDRY_SCHEDULE_POLL_SECONDS=300
# DB is FOUNDRY_ROOT/foundry.sqlite3. DATABASE_PATH is intentionally not a second setting.
OPENVERSE_API_KEY=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
SENTRY_DSN=

# Phase 5: server-only transport. Empty URL keeps the existing local subprocess bridge.
FOUNDRY_WORKER_URL=
FOUNDRY_WORKER_API_KEY=
# Test checkout only. Generate/set values in the deployment secret manager.
# Secret key must have the Stripe test-secret prefix; publishable key must be test-mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
FOUNDRY_DOWNLOAD_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success?order={ORDER_ID}&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel
