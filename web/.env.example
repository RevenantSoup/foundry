# Absolute data directory, or repository root (which resolves to its data/ folder).
# Default when unset: ../data relative to web/.
# FOUNDRY_ROOT=/absolute/path/to/foundry/data

# Default: repository .venv/bin/python if present, otherwise python3.
# FOUNDRY_PYTHON=/absolute/path/to/foundry/.venv/bin/python

# Live YouTube uses authorized local files named <video-id>.mp4.
# FOUNDRY_VIDEO_DIR=/absolute/path/to/licensed-videos

# Only required when using live sources / verification.
# YOUTUBE_API_KEY=
# OPENAI_API_KEY=
