# Absolute data directory, or repository root (which resolves to its data/ folder).
# Default when unset: ../data relative to web/.
# FOUNDRY_ROOT=/absolute/path/to/foundry/data

# Default: repository .venv/bin/python if present, otherwise python3.
# FOUNDRY_PYTHON=/absolute/path/to/foundry/.venv/bin/python

# Live YouTube uses authorized local files named <video-id>.mp4.
# FOUNDRY_VIDEO_DIR=/absolute/path/to/licensed-videos

# Only required when using live sources / verification.
# YOUTUBE_API_KEY=
# OPENAI_API_KEY=

# Optional Openverse OAuth bearer access token. Public requests otherwise.
# OPENVERSE_API_KEY=

# Admin-only session auth; CLI and buyer API do not use these credentials.
# FOUNDRY_ADMIN_USER=admin
# FOUNDRY_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# FOUNDRY_SESSION_SECRET=replace-with-at-least-32-random-characters
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# APP_VERSION=0.1.0
# Optional server-only monitoring; unset means no vendor integration.
# SENTRY_DSN=
# FOUNDRY_LOG_FILE=/absolute/path/to/data/logs/cli.jsonl
# FOUNDRY_ROOT/foundry.sqlite3 is the DB; DATABASE_PATH is not used.
